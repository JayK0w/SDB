# Standalone Docker Backup (SDB) — runtime configuration.
# Copy to .env and fill in the secrets. Every variable is optional unless
# stated otherwise; defaults are shown.

# --- Network ---------------------------------------------------------------
# SDB binds to loopback by default. Docker port publishing bypasses
# iptables/UFW, so when running SDB as a container the host-side mapping
# must also be loopback-only: 127.0.0.1:8080:8080.
SDB_LISTEN_HOST=127.0.0.1
SDB_LISTEN_PORT=8080

# --- Data ------------------------------------------------------------------
SDB_DATA_DIR=data
#SDB_DB_PATH=data/sdb.db

# --- Secrets (REQUIRED, min 32 characters) ----------------------------------
# Generate each one with: openssl rand -hex 32
# SDB_MASTER_KEY encrypts storage credentials and Restic passwords at rest
# (AES-256-GCM). Losing it makes stored storage configs unreadable.
SDB_MASTER_KEY=
SDB_JWT_SECRET=
# Docker-secrets alternative (takes precedence over the plain variable):
#SDB_MASTER_KEY_FILE=/run/secrets/sdb_master_key
#SDB_JWT_SECRET_FILE=/run/secrets/sdb_jwt_secret
SDB_TOKEN_TTL=1h

# --- Bootstrap ---------------------------------------------------------------
# First start only: when no user exists, an admin account is created.
# Without SDB_ADMIN_PASSWORD a strong random password is generated and
# printed once in the logs (change it after first login).
SDB_ADMIN_USERNAME=admin
#SDB_ADMIN_PASSWORD=
#SDB_ADMIN_PASSWORD_FILE=/run/secrets/sdb_admin_password

# --- Maintenance -------------------------------------------------------------
# Interval between scheduled repository integrity checks (restic check).
# 0 disables scheduled checks. Default: weekly.
SDB_CHECK_INTERVAL=168h

# --- Observability -----------------------------------------------------------
# Static bearer token protecting GET /metrics (Prometheus exposition).
# Leave empty to disable the endpoint entirely. Generate with:
#   openssl rand -hex 32
#SDB_METRICS_TOKEN=
#SDB_METRICS_TOKEN_FILE=/run/secrets/sdb_metrics_token

# --- Docker daemon -----------------------------------------------------------
# Leave SDB_DOCKER_HOST empty to use the local socket
# (unix:///var/run/docker.sock or npipe on Windows).
# tcp:// endpoints are REFUSED unless full mTLS material is provided.
#SDB_DOCKER_HOST=tcp://docker-host:2376
#SDB_DOCKER_TLS_VERIFY=true
#SDB_DOCKER_TLS_CA=/certs/ca.pem
#SDB_DOCKER_TLS_CERT=/certs/cert.pem
#SDB_DOCKER_TLS_KEY=/certs/key.pem
SDB_CONTAINER_STOP_TIMEOUT=30s
# Image used for the ephemeral backup worker (runs Restic with the target
# volumes mounted read-only).
#SDB_WORKER_IMAGE=restic/restic:0.18.0

# --- Logging -----------------------------------------------------------------
# Levels: debug | info | warn | error. Formats: json | text.
SDB_LOG_LEVEL=info
SDB_LOG_FORMAT=json
