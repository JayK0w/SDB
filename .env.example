# Configuration SDB — copier en .env et remplir les secrets.
# Tout est optionnel sauf mention contraire ; défauts indiqués.

# --- Réseau ------------------------------------------------------------------
# Loopback par défaut. La publication de port Docker contourne
# iptables/UFW : en conteneur, mapper côté hôte 127.0.0.1:8080:8080.
SDB_LISTEN_HOST=127.0.0.1
SDB_LISTEN_PORT=8080

# --- Données -----------------------------------------------------------------
SDB_DATA_DIR=data
#SDB_DB_PATH=data/sdb.db

# --- Secrets (REQUIS, 32 caractères min) --------------------------------------
# Générer avec : openssl rand -hex 32
# SDB_MASTER_KEY chiffre les identifiants de stockage et mots de passe
# restic au repos (AES-256-GCM). La perdre = configs de stockage illisibles.
SDB_MASTER_KEY=
SDB_JWT_SECRET=
# Variante secrets Docker (prioritaire sur la variable simple) :
#SDB_MASTER_KEY_FILE=/run/secrets/sdb_master_key
#SDB_JWT_SECRET_FILE=/run/secrets/sdb_jwt_secret
SDB_TOKEN_TTL=1h

# --- Amorçage ------------------------------------------------------------------
# Premier démarrage seulement : si aucun utilisateur, un admin est créé.
# Sans SDB_ADMIN_PASSWORD, un mot de passe fort est généré et affiché une
# fois dans les logs (à changer après la première connexion).
SDB_ADMIN_USERNAME=admin
#SDB_ADMIN_PASSWORD=
#SDB_ADMIN_PASSWORD_FILE=/run/secrets/sdb_admin_password

# --- Démon Docker ---------------------------------------------------------------
# SDB_DOCKER_HOST vide = socket local (unix:///var/run/docker.sock).
# Les endpoints tcp:// sont REFUSÉS sans matériel mTLS complet.
#SDB_DOCKER_HOST=tcp://docker-host:2376
#SDB_DOCKER_TLS_VERIFY=true
#SDB_DOCKER_TLS_CA=/certs/ca.pem
#SDB_DOCKER_TLS_CERT=/certs/cert.pem
#SDB_DOCKER_TLS_KEY=/certs/key.pem
SDB_CONTAINER_STOP_TIMEOUT=30s
# Image du worker éphémère (restic en entrypoint)
#SDB_WORKER_IMAGE=restic/restic:0.18.0

# --- Maintenance ----------------------------------------------------------------
# Intervalle entre vérifications d'intégrité (restic check). 0 = désactivé.
SDB_CHECK_INTERVAL=168h

# Fraction des données réellement RELUES par restic check. Sans ce réglage,
# check ne valide que la structure du dépôt : une corruption silencieuse d'un
# pack n'est découverte qu'au moment de restaurer. Vide = structure seule.
# Plus la valeur est haute, plus le contrôle est long et coûteux en I/O.
SDB_CHECK_READ_DATA_SUBSET=5%

# Une sortie restic 3 (fichiers sources illisibles) marque la sauvegarde en
# ÉCHEC plutôt qu'en avertissement. Passer à false accepte des sauvegardes
# incomplètes comme réussies — à ne faire qu'en connaissance de cause.
SDB_BACKUP_STRICT_PARTIAL=true

# Intervalle entre RESTAURATIONS DE VÉRIFICATION : le dernier snapshot de
# chaque dépôt est réellement extrait dans un volume jetable (sdb-verify-*),
# avec contrôle des empreintes par restic, puis le volume est supprimé.
# C'est la seule chose qui prouve qu'une sauvegarde est restaurable — le reste
# prouve seulement qu'elle existe. Coûteux en I/O : cadencer large.
# 0 = désactivé.
# SDB_VERIFY_INTERVAL=168h

# Rejouer au démarrage les planifications dont l'échéance est passée pendant
# un arrêt de SDB. DÉSACTIVÉ par défaut : une sauvegarde peut ARRÊTER son
# conteneur, et rejouer en masse au redémarrage d'un hôte qui vient de tomber
# stopperait la production au pire moment. Les échéances manquées restent
# signalées dans les logs et via sdb_schedule_missed_runs_total quel que soit
# ce réglage. Si activé : une seule reprise par planification, jamais l'arriéré.
SDB_SCHEDULE_CATCHUP=false

# --- Alertes ---------------------------------------------------------------------
# URL POSTée (JSON) sur run terminé en échec ou avertissement. Vide = aucune
# alerte sortante, les échecs ne sont visibles que dans /metrics et les logs.
# Peut contenir un jeton : n'est jamais journalisée.
# SDB_ALERT_WEBHOOK=https://hooks.example.com/services/XXX
SDB_ALERT_TIMEOUT=10s

# --- Observabilité ---------------------------------------------------------------
# Token statique protégeant GET /metrics (Prometheus). Vide = endpoint
# désactivé. Générer avec : openssl rand -hex 32
#SDB_METRICS_TOKEN=
#SDB_METRICS_TOKEN_FILE=/run/secrets/sdb_metrics_token

# --- Journalisation ---------------------------------------------------------------
# Niveaux : debug | info | warn | error. Formats : json | text.
SDB_LOG_LEVEL=info
SDB_LOG_FORMAT=json
